{
  "name": "reactor-run",
  "version": "1.0.0",
  "private": true,
  "description": "Reactor Run for iOS and Android (Capacitor shell around the web game)",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "node scripts/build-web.mjs && npx cap sync",
    "android": "node scripts/build-web.mjs && npx cap sync android && npx cap open android",
    "ios": "node scripts/build-web.mjs && npx cap sync ios && npx cap open ios",
    "assets": "npx capacitor-assets generate --ios --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "three": "^0.147.0"
  }
}
